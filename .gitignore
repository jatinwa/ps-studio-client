# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generation pipeline
/.cache
/scripts/jobs.json
/public/media/stills/*.webp
/public/media/sequences/*/

# hand-generated source plates (ingested into public/media)
/incoming/*
!/incoming/README.txt

# archived AI assets (not shipped)
/_archive

# original photographs — 829MB of camera files
# The site serves the derivatives in public/media/photos, which `npm run photos`
# builds from these. Committing the originals would push ~830MB to the remote
# and make every deploy clone it, for files the site never serves.
/incoming/

